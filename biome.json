{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!skills-lock.json",
      "!**/.agents",
      "!**/node_modules",
      "!bun.lock",
      "!**/dist",
      "!**/.turbo",
      "!**/.zed",
      "!**/routeTree.gen.ts",
      "!**/uniwind-env.d.ts",
      "!packages/trpc/src/generated"
    ]
  },
  "linter": {
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "info"
      },
      "nursery": {
        "noUndeclaredEnvVars": "error"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "extends": ["ultracite/biome/core", "ultracite/biome/react"]
}
