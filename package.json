{
  "name": "mavry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter='./apps/*'",
    "build": "turbo run build",
    "prod": "turbo run prod --filter='./apps/*'",
    "dev:web": "turbo run dev -F @mavry/web",
    "dev:api": "turbo run dev -F @mavry/api",
    "dev:mobile": "turbo run dev -F @mavry/mobile",
    "browser:install": "playwright install chromium",
    "browser:open": "playwright cli open",
    "browser:serve-artifacts": "bun scripts/playwright/serve-artifacts.ts",
    "browser:show": "playwright cli show",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "fix": "ultracite fix",
    "test:e2e": "bun scripts/playwright/run.ts test",
    "test:e2e:headed": "bun scripts/playwright/run.ts test --headed",
    "test:e2e:ui": "bun scripts/playwright/run.ts test --ui"
  },
  "dependencies": {
    "@mavry/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@mavry/ts-config": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/bun": "catalog:",
    "lefthook": "latest",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "ultracite": "7.8.3"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "@nestjs/common": "^11.1.27",
      "@nestjs/core": "^11.1.27",
      "@nestjs/platform-express": "^11.1.27",
      "@trpc/server": "^11.16.0",
      "@tanstack/react-form": "^1.28.0",
      "@tanstack/react-query": "^5.99.0",
      "@trpc/tanstack-react-query": "^11.16.0",
      "better-auth": "1.6.22",
      "lucide-react": "^1.21.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.1",
      "@trpc/client": "^11.16.0",
      "@polar-sh/better-auth": "^1.8.4",
      "nestjs-trpc": "^2.12.0",
      "reflect-metadata": "^0.2.2",
      "rxjs": "7.8.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.6.23"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "packageManager": "bun@1.3.14"
}
